# Intermedios regenerables: se reconstruyen con `make auditoria`
data/interim/

# Artefactos publicables: se reconstruyen con `make artefactos`
data/processed/

# Sitio ensamblado y desplegable: se reconstruye con `make sitio`
dist/

# Paquete de sistema de diseño para Claude Design: se reconstruye con `make kit`.
# No se versiona por la misma razón que dist/ — es una salida derivada, y cada
# regeneración produciría un diff de un megabyte de HTML generado.
design-system/

# Respuestas cacheadas de Crossref: ~800 archivos, se regeneran solos.
# Se conservan en disco para poder reejecutar el enriquecimiento sin volver a
# golpear la API, pero no se versionan.
data/cache/
# Ídem para las respuestas del registro de ORCID.

# Nunca desplegar la capa interna en la web pública (CLAUDE.md, <data_governance>).
# Se versiona en el repositorio de trabajo, pero queda fuera del bundle: la
# exclusión efectiva la aplica y verifica src/build/06_assemble_site.py.

# Capturas de verificación local
.shots/

__pycache__/
*.py[cod]
.venv/
.DS_Store

# Respaldos del asistente de revisión antes de sustituir el CSV de decisiones.
# El archivo bueno sí se versiona; sus copias de seguridad no.
internal/.respaldos/
